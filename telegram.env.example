# Copy to telegram.env on the server (same folder as manage.py) if env vars are not available.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_NOTIFICATION_GROUP_ID=-100xxxxxxxxxx
# Set to true only if the server has a working CA bundle for outbound HTTPS.
TELEGRAM_SSL_VERIFY=false
# Auto Telegram on new dispatch: enabled on prod (_prod) by default, disabled on dev (_dev).
# TELEGRAM_DISPATCH_NOTIFICATIONS_ENABLED=true
